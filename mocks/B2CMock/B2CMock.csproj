<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="users.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="clients.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="signing-key.pem" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
